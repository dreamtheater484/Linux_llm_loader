-def parse_toolcalls(text: str) -> list[ToolCall]:
+def _typed_value(raw: str, schema: dict):
+    expected = schema.get("type")
+    # The Qwen template writes string parameters verbatim, not as JSON.
+    # Preserve numeric-looking strings, literal null/true, and quote characters.
+    if expected == "string":
+        return raw
+    # Qwen sometimes emits Python-style booleans in its pseudo-XML. Interpret
+    # these only for an explicitly boolean parameter, never for string/union types.
+    if expected == "boolean" and raw in ("True", "False"):
+        return raw == "True"
+    return coerce_param_value(raw)
+
+
+def parse_toolcalls(text: str, tools=None) -> list[ToolCall]:
     # If there are outer <tool_call> wrappers, unwrap them; otherwise use the whole text
